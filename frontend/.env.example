# Backend API. Để trống nếu muốn gọi /api cùng origin qua Next.js rewrite.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth (anon key là khóa public dành cho frontend, không dùng service role key tại đây)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# true: bật chế độ kiosk và cơ chế tự khôi phục WebGL
NEXT_PUBLIC_KIOSK_MODE=false
