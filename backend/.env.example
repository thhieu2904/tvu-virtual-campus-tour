# === App ===
APP_NAME="TVU Virtual Campus Tour API"
DEBUG=false

# === CORS ===
CORS_ORIGINS=["http://localhost:3000"]

# === Google Gemini ===
GEMINI_API_KEY=your-gemini-api-key
GEMINI_AGENT_MODEL=gemini-3.5-flash
GEMINI_ANSWER_MODEL=gemini-3.5-flash
GEMINI_AGENT_THINKING_LEVEL=high
GEMINI_ANSWER_THINKING_LEVEL=default

# === Database (Supabase PostgreSQL + pgvector) ===
DATABASE_URL=postgresql+asyncpg://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# === Supabase Auth ===
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# === Cloudflare R2 (S3-compatible Storage) ===
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=tvu-tour-v1
R2_PUBLIC_URL=https://your-custom-domain.site
